  "noteTemplates": {
    "floor": "Below Rails {rails}'s required_ruby_version (>= {minRuby})",
    "kwarg": "Ruby 3.0's positional/keyword-argument separation breaks Rails {rails} outright (confirmed, e.g. rails/rails#40938 for 5.2)",
    "green-conf": "Ruby {ruby} was already out (or came out within a year) when Rails {rails} shipped — within the range Rails actually tests and tracks in its CI.",
    "green-inf": "Ruby {ruby} arrived ~{years} years into Rails {rails}'s life. Likely still within its maintenance window, but not confirmed against a specific Rails CI run — treat as a best-effort inference.",
    "blue-inf": "Ruby {ruby} shipped well after Rails {rails} was EOL'd; commonly reported to mostly work, but never an officially tested pairing — treat as a best-effort inference.",
    "workaround": "Runs only with a workaround: Ruby {ruby}'s built-in Set class and (from 3.4 on) removal of default gems like cgi clash with Rails {rails} internals until the fixes backported in 7.1+."
  },
  "noteRules": [
    {
      "name": "floor",
      "when": [
        {
          "match": [
            "status",
            "red"
          ]
        },
        {
          "belowFloor": true
        }
      ],
      "notes": [
        {
          "ref": "floor"
        }
      ]
    },
    {
      "name": "kwarg",
      "when": [
